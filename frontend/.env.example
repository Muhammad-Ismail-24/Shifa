# Base URL of the Shifa FastAPI backend (backend/main.py).
# Required — lib/api.ts treats an unset value as "backend not configured" and
# voice/shifaClient.ts then falls back to its local clarification-only mock.
VITE_API_URL=

# Set to "true" to force the local mock even when VITE_API_URL is set.
# Development only.
VITE_SHIFA_MOCK=

# Optional. Overrides the bundled landing-page hero video.
VITE_HERO_VIDEO_URL=
